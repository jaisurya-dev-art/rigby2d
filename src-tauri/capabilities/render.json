{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "render",
  "description": "Windowless render mode (Rigby2D --render): reads the project and its images, writes the rendered files, and reports to the rigby command line.",
  "windows": [
    "render"
  ],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
