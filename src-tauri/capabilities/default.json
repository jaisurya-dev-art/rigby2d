{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Editor window: native file dialogs, read/write of project, image and export files (with safe saves and numbered backups), the recovery and add-on folders in the app data, the interface scale, downloading runtimes, starters and add-ons from the Rigby2D releases and website, checking for and installing updates, and opening https links (documentation, website) in the browser.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-available-monitors",
    "core:window:allow-current-monitor",
    "core:webview:allow-create-webview-window",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-copy-file",
    "fs:allow-stat",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://github.com/jaisurya-dev-art/rigby2d/*"
        },
        {
          "url": "https://release-assets.githubusercontent.com/*"
        },
        {
          "url": "https://objects.githubusercontent.com/*"
        },
        {
          "url": "https://rigby2d.com/*"
        }
      ]
    }
  ]
}
