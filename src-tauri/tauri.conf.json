{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rigby2D",
  "version": "0.2.6",
  "identifier": "io.github.jaisurya-dev-art.rigby2d",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rigby2D",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "label": "main",
        "visible": false
      },
      {
        "label": "splash",
        "title": "Rigby2D",
        "url": "splash.html",
        "width": 720,
        "height": 405,
        "center": true,
        "resizable": false,
        "decorations": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "jaisurya-dev-art",
    "copyright": "Copyright (c) 2026 jaisurya-dev-art. Code licensed MIT OR Apache-2.0. Rigby2D and Hoverlabs names and logos are trademarks of Hoverlabs.",
    "category": "GraphicsAndDesign",
    "shortDescription": "2D skeletal animation for games, films and interactive experiences",
    "longDescription": "Rigby2D by Hoverlabs: open-source 2D skeletal animation for games, films and interactive experiences.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/jaisurya-dev-art/rigby2d",
    "license": "MIT OR Apache-2.0"
  }
}
